  visitor         Visitor?      @relation(fields: [visitorId], references: [id])
  session         Session?      @relation(fields: [sessionId], references: [id])
  paymentMatch    PaymentMatch? @relation(fields: [paymentMatchId], references: [id])
  conversionEvent WebsiteEvent? @relation(fields: [conversionEventId], references: [id])

  @@unique([paymentId, attributionModel])
  @@index([websiteId, calculatedAt])
  @@index([websiteId, attributionModel])
  @@index([websiteId, attributionConfidence])
  @@index([websiteId, firstTouchSource])
  @@index([websiteId, firstTouchCampaign])
  @@index([websiteId, firstTouchReferrerDomain])
  @@index([websiteId, firstTouchReferrerPath])
  @@index([websiteId, firstTouchLandingPath])
  @@index([websiteId, lastTouchSource])
  @@index([websiteId, lastTouchCampaign])
  @@index([websiteId, lastTouchReferrerDomain])
  @@index([websiteId, lastTouchReferrerPath])
  @@index([websiteId, lastTouchLandingPath])
  @@index([visitorId])
  @@index([sessionId])
  @@index([paymentMatchId])
  @@index([conversionEventId])
  @@map("payment_attribution")
}

model AttributionJob {
  id           String    @id() @default(uuid()) @map("attribution_job_id") @db.Uuid
  websiteId    String    @map("website_id") @db.Uuid
  paymentId    String?   @map("payment_id") @db.Uuid
  jobType      String    @map("job_type") @db.VarChar(50)
  jobStatus    String    @default("pending") @map("job_status") @db.VarChar(50)
  priority     Int       @default(0)
  attempts     Int       @default(0)
  errorMessage String?   @map("error_message")
  scheduledAt  DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  website Website  @relation(fields: [websiteId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([jobStatus, scheduledAt])
  @@index([websiteId, createdAt])
  @@index([websiteId])
  @@index([paymentId])
  @@map("attribution_job")
}

model ApiKey {
  id         String    @id() @default(uuid()) @map("api_key_id") @db.Uuid
  teamId     String?   @map("team_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  websiteId  String?   @map("website_id") @db.Uuid
  keyHash    String    @map("key_hash") @db.VarChar(255)
  name       String    @db.VarChar(100)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  team    Team?    @relation(fields: [teamId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  website Website? @relation(fields: [websiteId], references: [id])

  @@index([teamId])
  @@index([userId])
  @@index([websiteId])
  @@index([keyHash])
  @@map("api_key")
}

model AuditEvent {
  id           String   @id() @default(uuid()) @map("audit_event_id") @db.Uuid
  teamId       String?  @map("team_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  websiteId    String?  @map("website_id") @db.Uuid
  eventType    String   @map("event_type") @db.VarChar(100)
  resourceType String?  @map("resource_type") @db.VarChar(100)
  resourceId   String?  @map("resource_id") @db.Uuid
  ipAddress    String?  @map("ip_address") @db.VarChar(100)
  userAgent    String?  @map("user_agent")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team    Team?    @relation(fields: [teamId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  website Website? @relation(fields: [websiteId], references: [id])

  @@index([teamId, createdAt])
  @@index([userId, createdAt])
  @@index([websiteId, createdAt])
  @@index([eventType])
  @@map("audit_event")
}
